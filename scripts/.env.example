# Copy to .env next to tg_pull.py and fill in. Never commit the real .env.
# Get the API id/hash at https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: route Telegram through a proxy. Formats: socks5://user:pass@host:port, socks4://host:port, http://host:port
TELEGRAM_PROXY=

# Optional (read by check_vault.py / snapshot.py / tg_pull.py defaults; the installers pass it to launchd):
# SECOND_BRAIN_VAULT=~/Vault
# SECOND_BRAIN_SCHEDULED=~/Documents/Claude/Scheduled
